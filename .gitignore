xelab.pb
xsim.jou
xsim.log
vivado*.jou
vivado*.log
vivado_pid*.str
webtalk*.jou
webtalk*.log
usage_statistics_webtalk*
*.wdb
*.zip

# Vivado proje dizinleri (create_project -force ile kuruluyor)
*.xpr
*.runs/
*.sim/
*.gen/
*.srcs/
*.hbs

