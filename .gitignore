build/
*.vvp
*.out
sim
scos
sm0
*.vcd
*.fst
*.wdb

# uretilen program hex'i (asm.py uretir)
sw/imem.mem
sw/memData.mem
*.mem

# co-sim trace ciktilari
*_trace.log
golden_trace.log
rtl_trace.log

# ---- Vivado ara/uretilen dosyalari (repo kokune de sacilir) ----
*.jou
*.log
*.str
*.pb
*.dcp
*.rpt
.Xil/
.cache/
.hw/
.ip_user_files/
.sim/
xsim.dir/
